# Files and paths that must not be uploaded to production.
# Syntax is similar to .gitignore:
#   pattern     — ignore matching paths
#   !pattern    — un-ignore (exception)
#   # comment

# Secrets and local config
.env
.env.*
.env.example

# VCS and tooling
.git/
.gitignore
.uploadignore
Makefile
HANDOFF.md
scripts/
__pycache__/
*.pyc
aichat.db
*.db

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

.venv
.venv/

# Docs (MkDocs); not needed on app host
docs/
mkdocs.yml
site/
AGENTS.md
README.md
.cursor/

# Frontend source/tooling; upload built assets only
frontend/node_modules/
frontend/src/
frontend/*.json
frontend/*.html
frontend/*.ts
frontend/*.md
frontend/.oxlintrc.json
frontend/.gitignore
frontend/public/
!frontend/dist/
!frontend/dist/**

