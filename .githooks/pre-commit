#!/bin/sh
# Pre-commit: прогоняет тесты бэкенда и фронтенда; если что-то падает, коммит не проходит.
#
# Включается один раз после клонирования: `make hooks` (ставит core.hooksPath=.githooks).
# Обойти проверку: `git commit --no-verify`.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

failed=0

# .venv и frontend/node_modules в git не лежат. На свежем клоне инструментов нет —
# блокировать коммит из-за отсутствующего окружения неправильно, поэтому предупреждаем.
if [ -x ".venv/bin/python" ]; then
    echo "pre-commit: тесты бэкенда — make test-coverage (это ~35 секунд)"
    make test-coverage || failed=1
else
    echo "pre-commit: .venv не найден, тесты бэкенда пропущены — make venv"
fi

if [ -d "frontend/node_modules" ]; then
    echo "pre-commit: тесты фронтенда — npm run test"
    (cd frontend && npm run test) || failed=1
else
    echo "pre-commit: frontend/node_modules не найден, тесты фронтенда пропущены — make frontend-install"
fi

if [ "$failed" -ne 0 ]; then
    echo
    echo "pre-commit: тесты упали — коммит отменён."
    echo "pre-commit: почините или обойдите проверку: git commit --no-verify"
    exit 1
fi

echo "pre-commit: тесты прошли"
