# Application
OPENROUTER_API_KEY=
DEFAULT_MODEL=default
MODELS_CACHE_TTL=3600

# External tools
# Weather tool for /api/chat. Leave empty to disable the tool entirely.
OPENWEATHER_API_KEY=

# Пицца Лисицца (pzz.by) в чате. 1/true — включено. Заказы идут на неофициальный
# публичный API сайта (cookie-сессия + /api/v1/basket/save), только после confirm.
PZZ_ENABLED=1
PZZ_ORDERS_ENABLED=1

# Лимит download_file (байты). По умолчанию 2 МБ.
DOWNLOADS_MAX_BYTES=2097152

# API limits
API_DAILY_LIMIT=10
MAX_TOKENS_PER_USER=10

# Share links: TTL in days
SHARE_TTL_DAYS=30

# Arize AX / Phoenix tracing (optional). Same as example/aichat.
# Requires ARIZE_SPACE_ID + ARIZE_API_KEY.
# Endpoint conventions (transport is chosen automatically):
#   Arize AX cloud (gRPC, default)  -> https://otlp.<region>.arize.com/v1
#   Arize AX HTTPS                  -> https://otlp.<region>.arize.com/v1/traces
#   Local Phoenix (HTTP)            -> http://127.0.0.1:6006/v1/traces
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=aichat
ARIZE_OTLP_ENDPOINT=

# New Relic monitoring + log forwarding (optional). Set NEW_RELIC_LICENSE_KEY to enable.
# NEW_RELIC_USER_KEY is for New Relic API (GraphQL) queries; the agent itself doesn't need it.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_USER_KEY=
NEW_RELIC_APP_NAME=aichat

# Database: leave DATABASE_URL empty to use SQLite locally (./aichat.db).
# For MySQL (production), set MYSQL_* or DATABASE_URL.
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/aichat?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aichat
MYSQL_PASSWORD=
MYSQL_DATABASE=aichat

# Server
INSTANCE_HOST=127.0.0.1
PORT=8080
# SOCKET=/path/to/app.sock

# OAuth login (Google / Apple). Feature is disabled until ALL required vars are set.
# PUBLIC_BASE_URL is the public https origin used to build redirect URIs,
# e.g. https://aichat.example.com  (must be registered as a redirect URI in the providers).
PUBLIC_BASE_URL=
# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple "Sign in with Apple" (https://developer.apple.com/account/resources/identifiers)
# APPLE_CLIENT_ID is the Service ID; APPLE_PRIVATE_KEY is the contents of the .p8 key file.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# FTP deploy (scripts/deploy_ftp.py)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_DIR=.
