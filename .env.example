# Application
OPENROUTER_API_KEY=
DEFAULT_MODEL=default
MODELS_CACHE_TTL=3600

# e7.by (Ollama). Leave E7_BY_BASE_URL empty to disable this provider.
# Host (http://127.0.0.1:11434) or OpenAI-compatible base (.../v1).
# Public model ids are e7.by/<ollama-model>.
E7_BY_BASE_URL=
E7_BY_API_KEY=
E7_BY_TIMEOUT=300

# Arize AX / Phoenix tracing (optional). Same as /tmp/aichat example.
# Requires ARIZE_SPACE_ID + ARIZE_API_KEY. For local Phoenix HTTP collector:
#   ARIZE_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=aichat
ARIZE_OTLP_ENDPOINT=

# Database: leave DATABASE_URL empty to use SQLite locally (./aichat.db).
# For MySQL (production), set MYSQL_* or DATABASE_URL.
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/aichat?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aichat
MYSQL_PASSWORD=
MYSQL_DATABASE=aichat

# Server (local PORT: ~/development/PORTS.md — aichat = 20000)
INSTANCE_HOST=127.0.0.1
PORT=20000
# SOCKET=/path/to/app.sock

# FTP deploy (scripts/deploy_ftp.py)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_DIR=.
