# Application
OPENROUTER_API_KEY=
DEFAULT_MODEL=default
MODELS_CACHE_TTL=3600

# Системный промпт на все диалоги (/api/chat и /v1/chat/completions).
# Не задан — используется дефолт из app/config.py; задан пустым — промпт отключён.
#SYSTEM_PROMPT=

# e7 (Ollama). Leave E7_BY_BASE_URL empty to disable this provider.
# Host (http://127.0.0.1:11434) or OpenAI-compatible base (.../v1).
# Public model ids are e7/<ollama-model>.
E7_BY_BASE_URL=
E7_BY_API_KEY=
E7_BY_TIMEOUT=300

# ol (Ollama Cloud через официальный клиент `ollama`). Leave OLLAMA_API_KEY empty
# to disable this provider. Локального инференса нет: только облачные модели.
# Публичные id моделей ol/<имя>, upstream отправляется как <имя>:cloud.
OLLAMA_API_KEY=
OLL_HOST=https://ollama.com
OLL_TIMEOUT=300

# External tools
# Weather tool for /api/chat. Leave empty to disable the tool entirely.
OPENWEATHER_API_KEY=

# Пицца Лисицца (pzz.by) в чате. 1/true — включено. Заказы идут на неофициальный
# публичный API сайта (cookie-сессия + /api/v1/basket/save), только после confirm.
PZZ_ENABLED=1
PZZ_ORDERS_ENABLED=1

# Лимит download_file (байты). По умолчанию 2 МБ.
DOWNLOADS_MAX_BYTES=2097152

# Cloud.ru Object Storage (S3 API). generate_image выключен, пока это не заполнено.
# Path-style + SigV4. Bucket создавать заранее; ACL на объект не ставится.
# Access key собирается в коде: S3_TENANT_ID + S3_SA_KEY_ID → tenant_id:key_id.
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=
S3_PATH_STYLE=1
S3_PUBLIC_BASE_URL=
S3_TENANT_ID=c1bf89fc-60f6-4cdf-8b15-882091f5ea2e
S3_SA_KEY_ID=
S3_SA_KEY_SECRET=
# IMAGE_GENERATION_MODEL=black-forest-labs/flux.2-klein-4b
# IMAGE_GENERATION_DAILY_LIMIT=5

# API limits
API_DAILY_LIMIT=10
MAX_TOKENS_PER_USER=10

# Share links: TTL in days
SHARE_TTL_DAYS=30

# Arize AX / Phoenix tracing (optional). Same as example/aichat.
# Requires ARIZE_SPACE_ID + ARIZE_API_KEY.
# Endpoint conventions (transport is chosen automatically):
#   Arize AX cloud (gRPC, default)  -> https://otlp.<region>.arize.com/v1
#   Arize AX HTTPS                  -> https://otlp.<region>.arize.com/v1/traces
#   Local Phoenix (HTTP)            -> http://127.0.0.1:6006/v1/traces
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=aichat
ARIZE_OTLP_ENDPOINT=

# New Relic monitoring + log forwarding (optional). Set NEW_RELIC_LICENSE_KEY to enable.
# NEW_RELIC_USER_KEY is for New Relic API (GraphQL) queries; the agent itself doesn't need it.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_USER_KEY=
NEW_RELIC_APP_NAME=aichat

# Database: leave DATABASE_URL empty to use SQLite locally (./aichat.db).
# For MySQL (production), set MYSQL_* or DATABASE_URL.
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/aichat?charset=utf8mb4
# Local MySQL: docker compose up -d (image mysql:8.0.46, user/db from MYSQL_*).
# MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aichat
MYSQL_PASSWORD=
MYSQL_DATABASE=aichat

# Server
# DEBUG=true — дополнительно писать generate_image на диск: data/aichat/generated/…
DEBUG=false
# DEBUG / INFO / WARNING / ERROR / CRITICAL (default INFO). Completions and uvicorn.
LOG_LEVEL=INFO
INSTANCE_HOST=127.0.0.1
PORT=8080
# SOCKET=/path/to/app.sock

# OAuth login. Each provider is enabled independently when its vars + PUBLIC_BASE_URL are set.
# How to get credentials: docs/dev/oauth-providers.md
# PUBLIC_BASE_URL is the public https origin used to build redirect URIs
# and absolute Open Graph URLs for link previews (Telegram and others),
# e.g. https://aichat.example.com  (must be registered as a redirect URI in the providers).
PUBLIC_BASE_URL=
# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple "Sign in with Apple" (https://developer.apple.com/account/resources/identifiers)
# APPLE_CLIENT_ID is the Service ID; APPLE_PRIVATE_KEY is the contents of the .p8 key file.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Yandex ID (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID (https://id.vk.com/about/business/go). VK_CLIENT_SECRET — сервисный ключ
# приложения (можно задать как VK_SERVICE_TOKEN).
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# FTP deploy (scripts/deploy_ftp.py)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_DIR=.
